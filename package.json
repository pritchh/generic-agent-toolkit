{
  "name": "generic-agent-toolkit",
  "version": "0.1.0",
  "description": "Local MCP router: agents load catalog skills to decide which other MCPs and workflows to use",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "generic-agent-toolkit": "./bin/generic-agent-toolkit.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node bin/generic-agent-toolkit.mjs",
    "dev": "node bin/generic-agent-toolkit.mjs",
    "check:skills": "tsx scripts/check-skills.ts",
    "dashboard": "tsx scripts/build-dashboard.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tsx": "^4.19.4",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
